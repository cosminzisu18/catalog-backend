# Copy this file to .env and fill in the values for your machine.

PORT=3001
NODE_ENV=development

# MariaDB (create the database first, see README)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mariadb_password
DB_NAME=catalog_digital
# database used by npm run test:e2e (dropped and created on every run)
E2E_DB_NAME=catalog_digital_test
# migrations in src/database/migrations run when the server starts
DB_MIGRATIONS_RUN=true
# true prints the SQL queries in the console
DB_LOGGING=false

# short-lived access token; the refresh token is a separate cookie,
# stored hashed in the DB
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_SESSION_TTL=12h
REFRESH_REMEMBER_TTL=7d

# Secure cookies only work over HTTPS (production)
COOKIE_SECURE=false

# global request limit per IP (login has its own limit of 5 per minute)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# frontend address: the only origin allowed by CORS and the Origin check
CORS_ORIGIN=http://localhost:3000
